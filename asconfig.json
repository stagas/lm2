{
  "targets": {
    "debug": {
      "outFile": "as/build/index.wasm",
      "textFile": "as/build/index.wat",
      "optimizeLevel": 3,
      "converge": true,
      "sourceMap": true,
      "debug": true,
      "noAssert": true
    },
    "release": {
      "outFile": "as/build/index.wasm",
      "textFile": "as/build/index.wat",
      "sourceMap": true,
      "optimizeLevel": 3,
      "shrinkLevel": 0,
      "converge": false,
      "noAssert": false
    }
  },
  "options": {
    "enable": [
      "simd",
      "relaxed-simd",
      "threads"
    ],
    "importMemory": true,
    "initialMemory": 4096,
    "maximumMemory": 4096,
    "sharedMemory": true,
    "bindings": "esm",
    "runtime": "stub",
    "exportRuntime": true
  }
}
