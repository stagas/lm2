{
  "name": "asc-worklet",
  "version": "1.0.0",
  "author": "",
  "main": "index.js",
  "devDependencies": {
    "@types/audioworklet": "^0.0.88",
    "@types/bun": "^1.3.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "assemblyscript": "^0.28.9",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "description": "",
  "keywords": [],
  "license": "ISC",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"bun run dev:web\" \"bun run dev:api\"",
    "dev:web": "vite --open",
    "dev:api": "deno run -A --unstable-kv --env-file=.env --watch ./deno/server.ts",
    "install:all": "bun run install:web && bun run install:api",
    "install:web": "bun install",
    "install:api": "deno install --no-npm",
    "build": "vite build",
    "test": "bun test"
  },
  "type": "module",
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zustand": "^5.0.9",
    "zod": "^3.25.76"
  }
}
