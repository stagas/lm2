{
  "name": "asc-worklet",
  "version": "1.0.0",
  "author": "",
  "main": "index.js",
  "type": "module",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"bun run dev:web\" \"bun run dev:api\"",
    "dev:web": "vite --open",
    "dev:api": "deno run -A --unstable-kv --env-file=.env --watch ./deno/server.ts",
    "install:all": "bun run install:web && bun run install:api",
    "install:web": "bun install",
    "install:api": "deno install --no-npm",
    "build": "vite build",
    "test": "bun test"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/audioworklet": "^0.0.88",
    "@types/bun": "^1.3.5",
    "assemblyscript": "^0.28.9",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "preact": "^10.28.1",
    "react-social-icons": "^6.25.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.9"
  }
}
